# Archlast Debian builder image: full engine build deps on trixie-slim.
FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git ca-certificates \
    libcurl4-openssl-dev libpng-dev libjpeg-dev libsqlite3-dev \
    libogg-dev libvorbis-dev libopenal-dev libfreetype6-dev \
    libjsoncpp-dev libgmp-dev libluajit-5.1-dev libleveldb-dev \
    libncurses-dev libzstd-dev gettext libsdl2-dev libzip-dev \
    libpq-dev libspatialindex-dev libhiredis-dev pkg-config \
    desktop-file-utils \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /src
