# Archlast Server Configuration for Coolify
# Copy this file to .env and adjust values for your deployment

# Server identity
SERVER_NAME=Archlast Server
SERVER_DESCRIPTION=Archlast Survival Sandbox RPG

# Game settings
GAME_ID=archlast
MAX_USERS=20

# World configuration (mounted as volume)
WORLD_PATH=/home/archlast/.minetest/world

# Resource limits (optional, defaults in docker-compose.yml)
CPU_LIMIT=2.0
MEMORY_LIMIT=2G